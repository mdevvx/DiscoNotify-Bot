# ── Environment ──────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Discord ──────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Prefix for owner-only text commands (e.g. !sync). Not used for
# slash commands.
DISCORD_COMMAND_PREFIX=!

# Custom status under the bot's name (max 128 characters; empty = none).
# DISCORD_STATUS_TEXT=/pulsenotify help | pulsenotify.duoplus.org

# Comma-separated Discord user IDs allowed to run owner/developer-only
# commands (!sync, etc.) in addition to the application's own
# owner/team, which is resolved automatically at startup.
DISCORD_OWNER_IDS=

# Guild ID to instantly sync slash commands to while developing.
# Leave empty in production — use `!sync global` instead.
DEV_GUILD_ID=

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
# Use the secret key (starts with sb_secret_ — Dashboard > Settings > API
# Keys), not the publishable key. The older service_role key still works
# too (Supabase is phasing it out by end of 2026) but the secret key is
# the one to use for any new setup. Either way, this bypasses Row Level
# Security and must never be exposed to end users or committed to source
# control.
SUPABASE_KEY=

# ── Platform APIs (optional — filled in as each platform is added) ───
# X (Twitter) needs no key. Each X account is checked every ~45s × the
# number of different X accounts followed (X allows 30 checks per 15 min),
# never faster than TWITTER_MIN_POLL_INTERVAL_SECONDS.
# TWITTER_ENABLED=true
# TWITTER_MIN_POLL_INTERVAL_SECONDS=60

# YouTube Data API v3 key (server-side "API key" credential type, not
# OAuth — public channel/video data doesn't need OAuth). Create one at
# https://console.cloud.google.com/apis/credentials with the "YouTube
# Data API v3" enabled on the project.
YOUTUBE_API_KEY=

# Twitch app credentials (Phase 5) — create an app at
# https://dev.twitch.tv/console/apps to get these. Used only for the OAuth
# client-credentials grant (an app access token); no per-broadcaster
# authorization is needed for live/offline detection.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick app credentials (Phase 6) — create an app at
# https://kick.com/settings/developer to get these. Same OAuth
# client-credentials model as Twitch: an app access token, no
# per-broadcaster authorization needed for live/offline detection.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Instagram Graph API "Business Discovery" — new posts and Reels from any
# public Instagram Business/Creator account (never personal accounts).
# Both values come from YOUR OWN Facebook Page + linked Instagram
# professional account; step-by-step in README's "Instagram setup".
# INSTAGRAM_ACCESS_TOKEN must be the Page token fetched with an *extended*
# user token (it then never expires) and carry instagram_basic,
# instagram_manage_insights and pages_read_engagement. The bot checks it at
# startup and logs a warning if it's short-lived or missing a permission.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Meta allows 200 calls/hour while the app is in Development mode; the poll
# interval stretches with the number of accounts to stay under it.
# INSTAGRAM_HOURLY_CALL_LIMIT=200
# INSTAGRAM_MIN_POLL_INTERVAL_SECONDS=30

# Facebook and TikTok have no adapter — as of 2026 neither platform offers
# an official, ToS-compliant way for this bot to monitor a Page/creator
# that hasn't individually authorized the app (Facebook's closest
# equivalent, "Page Public Content Access," requires Meta Business
# Verification and is scoped to "analyze/display" use cases, not
# guaranteed to fit a notification bot; TikTok's platform is entirely
# built around creators connecting their own account, the opposite of
# monitoring one you don't control). See README's Phase 7 section. Revisit
# if either platform's policy changes.

# ── Monitoring framework (Phase 3) ────────────────────────────────────
# All optional — sensible defaults are baked in. Only set these to tune
# behavior for a specific deployment.
# MONITORING_CONTENT_POLL_INTERVAL_SECONDS=300
# MONITORING_LIVE_POLL_INTERVAL_SECONDS=60
# MONITORING_MAX_RETRY_ATTEMPTS=5
# MONITORING_RETRY_BASE_DELAY_SECONDS=2
# MONITORING_RETRY_MAX_DELAY_SECONDS=300
# MONITORING_RATE_LIMIT_REQUESTS=30
# MONITORING_RATE_LIMIT_PERIOD_SECONDS=60
# MONITORING_EVENT_QUEUE_SIZE=1000
# MONITORING_HEALTH_DEGRADED_AFTER=3
# MONITORING_HEALTH_ERROR_AFTER=8
# MONITORING_HTTP_TIMEOUT_SECONDS=15

# ── YouTube quota (Phase 4) ────────────────────────────────────────────
# Free tier is 10,000 units/day, shared by every YouTube account this bot
# monitors (it's one budget per API key, not per account or per guild).
# Each channel check (new uploads, Shorts, Premieres AND live status) costs
# at most 2 units, so the poll interval stretches with the number of
# distinct channels to fit the day's budget: 30s for 1 channel, ~58s for
# 3, ~96s for 5, ~192s for 10. YOUTUBE_MIN_POLL_INTERVAL_SECONDS is the floor.
# Raise YOUTUBE_DAILY_QUOTA_UNITS only after Google approves a quota
# extension request — you cannot pay to raise it directly.
# YOUTUBE_DAILY_QUOTA_UNITS=10000
# YOUTUBE_MIN_POLL_INTERVAL_SECONDS=30

# ── Payments (billing/) ─────────────────────────────────────────────────
# $2.99/month per server after a 7-day free trial. Card payments go through
# Polar (polar.sh): /pulsenotify subscribe makes the bot create a hosted
# checkout per server and /pulsenotify cancel opens Polar's billing portal —
# no website pages needed. Crypto (NOWPayments) is paid on your website.
# Step-by-step: README "Payments setup". Bot owners can whitelist servers
# with the !whitelist text command (owner-only, hidden).
# NOTHING is enforced until BILLING_ENABLED=true.
# BILLING_ENABLED=false
# Monthly price per server in USD, as shown in Discord — it MUST equal the
# price of the Polar product (the startup log warns if it doesn't).
# BILLING_PRICE_USD=2.99
# BILLING_TRIAL_DAYS=7
# BILLING_GRACE_DAYS=3
# BILLING_POLL_INTERVAL_SECONDS=60
# Polar: an ORGANIZATION access token with only checkouts:write,
# subscriptions:read, customer_sessions:write (+ products:read optional), and
# the ID of the monthly product (no trial on the product). Set these only in
# your host's environment variables, never in git.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
# POLAR_SANDBOX=false
# Where Polar sends people after paying (default: Polar's own page).
# POLAR_SUCCESS_URL=
# Crypto (optional): your website's payment page; the bot adds ?guild_id=<server ID>.
BILLING_SUBSCRIBE_URL=
# Upgrade reminder DM'd to the server owner when the trial/subscription runs
# out: right away, then every 7 days, at most 3 in total.
# BILLING_REMINDER_EVERY_DAYS=7
# BILLING_REMINDER_MAX=3
NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_SANDBOX=false

# Most accounts one server can monitor (all platforms together). Shared API
# limits make this the guard against one server using them up for everyone.
MAX_ACCOUNTS_PER_SERVER=25
